{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2WKG/flux/schemas/event-baseline/v1",
  "title": "Flux historical event baseline bundle",
  "type": "object",
  "required": ["schema_version", "hazard", "event", "source_receipts", "records"],
  "properties": {
    "schema_version": {"const": "event-baseline/v1"},
    "hazard": {"type": "string", "minLength": 1},
    "event": {"$ref": "#/$defs/event"},
    "source_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receipt"}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "additionalProperties": false,
  "$defs": {
    "utc": {"type": "string", "pattern": "Z$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "event": {
      "type": "object",
      "required": ["event_id", "parent_system_id", "primary_hazard", "secondary_hazards", "compound", "source_event_ids", "context_window", "event_window", "recovery_window", "disposition", "selection_basis", "uncertainties"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"}, "parent_system_id": {"$ref": "#/$defs/identifier"},
        "primary_hazard": {"type": "string", "minLength": 1}, "secondary_hazards": {"type": "array", "items": {"type": "string"}}, "compound": {"type": "boolean"}, "source_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "context_window": {"$ref": "#/$defs/window"}, "event_window": {"$ref": "#/$defs/window"}, "recovery_window": {"$ref": "#/$defs/window"},
        "disposition": {"enum": ["candidate_only", "accepted", "rejected", "shortfall"]}, "selection_basis": {"type": "string", "minLength": 1}, "exclusions": {"type": "array", "items": {"type": "string"}}, "uncertainties": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "window": {"type": "object", "required": ["start_utc", "end_utc"], "properties": {"start_utc": {"$ref": "#/$defs/utc"}, "end_utc": {"$ref": "#/$defs/utc"}}, "additionalProperties": false},
    "receipt": {
      "type": "object", "required": ["receipt_id", "provider", "url", "release", "retrieved_at_utc", "license_or_access", "raw_sha256", "filtered_sha256", "bytes", "etag", "units", "timezone_conversion", "filters", "grid_index_mapping", "gaps"],
      "properties": {"receipt_id": {"$ref": "#/$defs/identifier"}, "provider": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "release": {"type": ["string", "null"]}, "retrieved_at_utc": {"$ref": "#/$defs/utc"}, "license_or_access": {"type": "string"}, "raw_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "filtered_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": ["integer", "null"], "minimum": 0}, "etag": {"type": ["string", "null"]}, "units": {"type": "string"}, "timezone_conversion": {"type": "string"}, "filters": {"type": "string"}, "grid_index_mapping": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}}, "acquisition": {"type": ["object", "null"], "required": ["acquisition_complete", "acquisition_method", "source_system_id", "source_file", "source_file_id", "source_file_bytes", "integrity_basis", "raw_artifact_uri", "raw_artifact_sha256", "source_sidecar_uri", "source_sidecar_sha256", "filtered_artifact_uri", "filtered_artifact_sha256"], "properties": {"acquisition_complete": {"const": true}, "acquisition_method": {"type": "string"}, "source_system_id": {"type": "string"}, "source_file": {"type": "string"}, "source_file_id": {"type": ["string", "integer"]}, "source_file_bytes": {"type": "integer", "minimum": 0}, "integrity_basis": {"type": "string"}, "raw_artifact_uri": {"type": "string"}, "raw_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_sidecar_uri": {"type": "string"}, "source_sidecar_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "filtered_artifact_uri": {"type": "string"}, "filtered_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}}, "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["record_id", "county_fips", "boundary_vintage", "scenario_id", "window_start_utc", "window_end_utc", "disposition", "mode", "provenance_receipt_ids", "source_evidence_status", "source_row_keys", "source_slices", "weather", "outage", "matched_coverage_decision", "label", "forecast"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"}, "county_fips": {"type": "string", "pattern": "^[0-9]{5}$"}, "boundary_vintage": {"type": "string", "minLength": 1}, "scenario_id": {"$ref": "#/$defs/identifier"}, "window_start_utc": {"$ref": "#/$defs/utc"}, "window_end_utc": {"$ref": "#/$defs/utc"}, "disposition": {"enum": ["candidate_only", "accepted", "rejected", "shortfall"]}, "mode": {"enum": ["replay", "forecast"]}, "provenance_receipt_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}, "source_evidence_status": {"enum": ["available", "unavailable"]}, "source_row_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}, "source_slices": {"type": "array", "items": {"$ref": "#/$defs/source_slice"}}, "weather": {"$ref": "#/$defs/coverage"}, "outage": {"$ref": "#/$defs/coverage"}, "matched_coverage_decision": {"enum": ["matched", "not_matched", "unavailable"]}, "label": {"$ref": "#/$defs/label"}, "forecast": {"$ref": "#/$defs/forecast"}
      }, "additionalProperties": false
    },
    "coverage": {"type": "object", "required": ["coverage", "evidence_kind", "observation_kind", "source_receipt_ids", "expected_samples", "observed_samples", "missing_timestamps", "event_report", "notes"], "properties": {"coverage": {"enum": ["covered", "uncovered", "UncoveredLabel"]}, "evidence_kind": {"enum": ["time_series_or_grid", "authoritative_event_report", "not_assessed"]}, "observation_kind": {"enum": ["observed", "modeled", "not_applicable"]}, "source_receipt_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}, "expected_samples": {"type": ["integer", "null"], "minimum": 0}, "observed_samples": {"type": ["integer", "null"], "minimum": 0}, "missing_timestamps": {"type": "array", "items": {"$ref": "#/$defs/utc"}}, "event_report": {"type": ["object", "null"], "properties": {"source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "source_window": {"$ref": "#/$defs/window"}, "spatial_scope": {"enum": ["county", "zone", "point", "regional", "track"]}, "scope_identifier": {"type": "string", "minLength": 1}, "limitations": {"type": "string", "minLength": 1}}, "required": ["source_event_ids", "source_window", "spatial_scope", "scope_identifier", "limitations"], "additionalProperties": false}, "notes": {"type": "string"}}, "additionalProperties": false},
    "source_slice": {"type": "object", "required": ["receipt_id", "county_fips", "start_utc", "end_utc"], "properties": {"receipt_id": {"$ref": "#/$defs/identifier"}, "county_fips": {"type": "string", "pattern": "^[0-9]{5}$"}, "start_utc": {"$ref": "#/$defs/utc"}, "end_utc": {"$ref": "#/$defs/utc"}}, "additionalProperties": false},
    "label": {"type": "object", "required": ["rule_version", "status", "observed_outage_customers", "customer_denominator", "outage_rate", "positive"], "properties": {"rule_version": {"const": "county_outage_5pct_v1"}, "status": {"enum": ["computed", "unavailable", "UncoveredLabel"]}, "observed_outage_customers": {"type": ["number", "null"], "minimum": 0}, "customer_denominator": {"type": "object", "required": ["status", "value"], "properties": {"status": {"enum": ["available", "unavailable"]}, "value": {"type": ["number", "null"], "exclusiveMinimum": 0}}, "additionalProperties": false}, "outage_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "positive": {"type": ["boolean", "null"]}}, "additionalProperties": false},
    "forecast": {"type": "object", "required": ["prediction_cutoff_utc", "forecast_evaluation", "inputs"], "properties": {"prediction_cutoff_utc": {"type": ["string", "null"], "pattern": "Z$"}, "forecast_evaluation": {"enum": ["not_forecast_scored", "eligible"]}, "inputs": {"type": "array", "items": {"type": "object", "required": ["receipt_id", "published_or_available_at_utc", "run_or_init_utc", "lead_hours", "valid_time_utc", "f00_receipt_id", "f01_receipt_id"], "properties": {"receipt_id": {"$ref": "#/$defs/identifier"}, "published_or_available_at_utc": {"$ref": "#/$defs/utc"}, "run_or_init_utc": {"$ref": "#/$defs/utc"}, "lead_hours": {"type": "number", "minimum": 0}, "valid_time_utc": {"$ref": "#/$defs/utc"}, "f00_receipt_id": {"type": ["string", "null"]}, "f01_receipt_id": {"type": ["string", "null"]}}, "additionalProperties": false}}}, "additionalProperties": false}
  }
}
