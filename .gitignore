data/raw/
data/duck/*.duckdb
data/parquet/
# Fresh rebuild output location used by the documented safe-rebuild runbook.
run-artifacts/
datasets/raw/
.venv/
node_modules/
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
# Local 3D asset deliveries; the contract forbids committing binaries
build/
web/dist-harness/
web/dist-renderer-harness/
__pycache__/
*.pyc
.env
graphify-out/cache/
graphify-out/.graphify_*
**/graphify-out/cache/
**/graphify-out/.graphify_*
graphify-out/graph.json
graphify-out/graph.html
.worktrees/
# EDA outputs written by scripts/run_eda.py defaults
data/eda-report.json
data/eda-summary.md
data/demo/*.local.json

# 3D model binaries are never committed: docs/design/3d-asset-contract.md says
# the asset pipeline (2WKG-374 / 2WKG-320) produces and stores them, not Git.
# scripts/validate_asset_archetypes.py reports any that appear anyway.
data/3d/**/*.glb
data/3d/**/*.gltf
web/public/**/*.glb
web/public/**/*.gltf

# Cloudflare Tunnel credentials and the filled-in ingress config live on the
# origin host, never in Git. deploy/cloudflared/config.example.yml is the
# template; see docs/runbooks/static-origin-and-tunnel.md.
.cloudflared/
deploy/cloudflared/config.yml
deploy/cloudflared/*.json
# Build-copied Flux pack (models, previews, metadata and sprite rasters).
web/public/assets/flux-grid/

# Bulk physical-inventory artifacts produced by pipelines.texas_hifld_lines.
data/physical-inventory/
