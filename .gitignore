data/raw/
data/duck/*.duckdb
data/parquet/
.venv/
node_modules/
web/node_modules/
web/dist/
# Local 3D asset deliveries; the contract forbids committing binaries
build/
web/dist-harness/
web/dist-renderer-harness/
__pycache__/
*.pyc
.env
graphify-out/cache/
graphify-out/.graphify_*
**/graphify-out/cache/
**/graphify-out/.graphify_*
