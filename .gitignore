# Cloudflare Tunnel credentials and the filled-in ingress config live on the
# origin host, never in Git. deploy/cloudflared/config.example.yml is the
# template; see docs/runbooks/static-origin-and-tunnel.md.
.cloudflared/
deploy/cloudflared/config.yml
deploy/cloudflared/*.json
