{
  "name": "flux-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "npm run lint && tsc --noEmit && node scripts/build.mjs",
    "dev": "npm run build && node server.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-browser-boundary.mjs",
    "test:data": "node --test --test-timeout=10000 src/data/*.test.mjs",
    "test:static-demo": "npm run build && node --test test/static-demo.test.mjs",
    "test:rehearsal": "npm run build && node --test test/rehearsal.test.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.11",
    "@deck.gl/layers": "^9.3.11",
    "@deck.gl/react": "^9.3.11",
    "@tanstack/react-query": "^5.90.0",
    "apache-arrow": "^21.2.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "deck.gl": "^9.3.11",
    "express": "latest",
    "lucide-react": "^0.545.0",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^4.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "latest",
    "jsdom": "30.0.1",
    "typescript": "^5.9.3"
  }
}
