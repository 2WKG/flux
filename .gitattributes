# Normalise line endings in the repository index so tracked text is stored as LF
# regardless of the checkout platform. The published calibration digests are
# SHA-256 of this LF-canonical content.
* text=auto eol=lf

*.json text eol=lf
*.md text eol=lf

# Published physical-inventory releases are gzip streams: never line-ending
# normalised, and never diffed as text. Their digests are recorded in
# data/artifacts/physical_inventory/manifest-<release>.json and re-hashed by
# tests/test_physical_inventory_acceptance.py.
*.gz binary

# NumPy weight archives are zip streams: never line-ending normalised, because
# the artifact records their SHA-256 (models/jepa writes both together).
*.npz binary
